{
  "info": {
    "name": "EMS API",
    "description": "Employee Management System — ตาม SPEC.md §4 (API contract). Base path /api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ems-api-collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "employeeId", "value": "1" },
    { "key": "departmentId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/employees?q=&department_id=&is_active=&join_date_from=&join_date_to=&salary_min=&salary_max=&sort=id&order=asc&page=1&page_size=20",
              "host": ["{{baseUrl}}"],
              "path": ["employees"],
              "query": [
                { "key": "q", "value": "", "disabled": true },
                { "key": "department_id", "value": "", "disabled": true },
                { "key": "is_active", "value": "", "disabled": true },
                { "key": "join_date_from", "value": "", "disabled": true },
                { "key": "join_date_to", "value": "", "disabled": true },
                { "key": "salary_min", "value": "", "disabled": true },
                { "key": "salary_max", "value": "", "disabled": true },
                { "key": "sort", "value": "id" },
                { "key": "order", "value": "asc" },
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get employee by id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{employeeId}}"]
            }
          }
        },
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dana Lee\",\n  \"department_id\": 1,\n  \"salary\": \"61000.00\",\n  \"join_date\": \"2026-09-01\",\n  \"is_active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
          }
        },
        {
          "name": "Update employee (PUT - full replace)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dana Lee\",\n  \"department_id\": 1,\n  \"salary\": \"65000.00\",\n  \"join_date\": \"2026-09-01\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{employeeId}}"]
            }
          }
        },
        {
          "name": "Delete employee",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{employeeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Employees - validation examples (ควรได้ 400)",
      "item": [
        {
          "name": "Create - salary มีสัญลักษณ์เงิน (format)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Salary\",\n  \"department_id\": 1,\n  \"salary\": \"$65000\",\n  \"join_date\": \"2026-09-01\",\n  \"is_active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
          }
        },
        {
          "name": "Create - join_date ไม่มีจริงในปฏิทิน (format)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Date\",\n  \"department_id\": 1,\n  \"salary\": \"50000.00\",\n  \"join_date\": \"2023-02-30\",\n  \"is_active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
          }
        },
        {
          "name": "Create - is_active เป็น string (type)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Active\",\n  \"department_id\": 1,\n  \"salary\": \"50000.00\",\n  \"join_date\": \"2026-01-01\",\n  \"is_active\": \"true\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
          }
        },
        {
          "name": "Create - field แปลกปลอม email (unknown field)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Extra Field\",\n  \"department_id\": 1,\n  \"salary\": \"50000.00\",\n  \"join_date\": \"2026-01-01\",\n  \"is_active\": true,\n  \"email\": \"x@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
          }
        },
        {
          "name": "Update - ไม่ส่ง is_active (PUT ต้องครบทุกช่อง)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Missing Active\",\n  \"department_id\": 1,\n  \"salary\": \"50000.00\",\n  \"join_date\": \"2026-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["employees", "{{employeeId}}"]
            }
          }
        },
        {
          "name": "Create - มี id ใน body (not_allowed)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 999,\n  \"name\": \"Has Id\",\n  \"department_id\": 1,\n  \"salary\": \"50000.00\",\n  \"join_date\": \"2026-01-01\",\n  \"is_active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/employees", "host": ["{{baseUrl}}"], "path": ["employees"] }
          }
        }
      ]
    },
    {
      "name": "Departments",
      "item": [
        {
          "name": "List departments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] }
          }
        },
        {
          "name": "Create department",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/departments", "host": ["{{baseUrl}}"], "path": ["departments"] }
          }
        },
        {
          "name": "Update department",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Engineering Team\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "{{departmentId}}"]
            }
          }
        },
        {
          "name": "Delete department",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/departments/{{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["departments", "{{departmentId}}"]
            }
          }
        }
      ]
    }
  ]
}
