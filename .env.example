# คัดลอกไฟล์นี้เป็น .env ก่อนรัน docker compose
# ไฟล์ .env จริงห้าม commit

# --- ฐานข้อมูล ---
POSTGRES_USER=ems
POSTGRES_PASSWORD=ems_local_password
POSTGRES_DB=ems

# พอร์ตที่ publish ออกมาที่เครื่อง ตั้งเป็น 55432 เพราะ 5432 ถูก Postgres ที่ลงในเครื่องใช้อยู่
DB_PORT_HOST=55432

# --- ฐานข้อมูลสำหรับเทสต์ ---
# สร้างอัตโนมัติโดย db/init/01-create-test-db.sh ตอน volume ว่างครั้งแรก
# เทสต์รันบนเครื่อง ไม่ได้รันในคอนเทนเนอร์ จึงต่อผ่าน localhost + DB_PORT_HOST
TEST_DB_NAME=ems_test
TEST_DB_HOST=localhost
TEST_DB_PORT=55432

# --- พอร์ตของแอป ---
API_PORT=3000
WEB_PORT=5173
